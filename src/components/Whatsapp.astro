---
import What from "@assets/whatsapp.svg";
const { label = "Disponible", href = "https://wa.link/ccu0av" } = Astro.props;
---

<a
    href={href}
    target="_blank"
    class="fixed bottom-6 right-6 z-50 group flex items-center transition-all duration-500"
>
    <!-- Letrero / Solapa -->
    <span
        class="absolute right-full mr-2 px-4 py-2 bg-atunlu-blue text-white text-xs font-black tracking-widest rounded-xl shadow-xl opacity-0 translate-x-4 group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-500 whitespace-nowrap pointer-events-none border border-white/20"
    >
        INFO ATUNLu
    </span>

    <!-- Icono WhatsApp -->
    <div
        class="relative hover:scale-110 active:scale-95 transition-transform duration-300"
    >
        <img
            src={What.src}
            class="h-14 w-14 drop-shadow-2xl"
            alt="WhatsApp ATUNLu"
        />
        <span class="absolute bottom-1 right-1 flex h-12 w-12">
            <span
                class="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75"
            ></span>
            <span class="relative inline-flex rounded-full h-12 w-12"></span>
        </span>
    </div>
</a>
