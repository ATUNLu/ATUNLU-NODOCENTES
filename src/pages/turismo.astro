---
import Layout from "@layouts/Layout.astro";
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import fondoDark from "@assets/images/fondos/fondo-dark.svg";

import imgCalamuchita from "@assets/images/turismo/calamuchita-cordoba.jpg";
import imgGiardino from "@assets/images/turismo/villa-giardino-cordoba.jpg";
import imgMarDeAjo from "@assets/images/turismo/mar-de-ajo-costa-atlantica.jpg";
import imgMarDelPlata from "@assets/images/turismo/mar-del-plata-costa-atlantica.jpg";

const destinos = [
    {
        nombre: 'Colonia "Evita"',
        ubicacion: "Santa Rosa De Calamuchita, Córdoba",
        icon: "ph:mountains",
        imagen: imgCalamuchita,
    },
    {
        nombre: 'Apart "17 de Octubre"',
        ubicacion: "Villa Giardino, Córdoba",
        icon: "ph:mountains",
        imagen: imgGiardino,
    },
    {
        nombre: "Apart 26 de Noviembre",
        ubicacion: "Mar De Ajo, Costa Atlántica",
        icon: "ph:waves",
        imagen: imgMarDeAjo,
    },
    {
        nombre: 'Hotel "22 de Noviembre"',
        ubicacion: "Mar Del Plata",
        icon: "ph:waves",
        imagen: imgMarDelPlata,
    },
];
---

<Layout title="Turismo FATUN | ATUNLu" isOpaque={true}>
    <main class="pt-20 overflow-hidden">
        <!-- Hero Section -->
        <section class="relative py-24 bg-atunlu-navy overflow-hidden">
            <div class="absolute inset-0 opacity-10">
                <div class="absolute inset-0 bg-[radial-gradient(circle_at_50%_50%,rgba(37,99,235,0.4),transparent_70%)]"></div>
            </div>
            <div class="max-w-7xl mx-auto px-6 relative z-10 text-center">
                <div class="inline-block w-20 h-1.5 bg-atunlu-blue rounded-full mb-8 reveal"></div>
                <h1 class="text-5xl md:text-7xl font-black text-white leading-[1.1] tracking-tight mb-6 reveal">
                    Turismo FATUN
                </h1>
                <p class="text-xl text-blue-100/80 max-w-2xl mx-auto leading-relaxed reveal text-pretty">
                    Destinos turísticos exclusivos para el descanso de las y los Nodocentes.
                </p>
            </div>
        </section>

        <!-- Intro Content -->
        <section class="py-24 bg-white">
            <div class="max-w-7xl mx-auto px-6">
                <div class="space-y-10 reveal max-w-4xl mx-auto">
                    <div class="prose prose-xl prose-slate max-w-none text-center sm:text-left">
                        <p class="text-gray-600 leading-relaxed text-lg mb-6">
                            En la sede de ATUNLu está abierta la inscripción para los diferentes destinos turísticos que ofrece la Federación Argentina del Trabajador de las Universidades Nacionales (FATUN) para el descanso de las y los Nodocentes.
                        </p>

                        <div class="bg-atunlu-lightBlue/30 p-8 rounded-3xl border-l-8 border-atunlu-blue mt-12 text-left">
                            <h3 class="text-xl text-atunlu-navy font-bold flex items-center gap-3 mb-4">
                                <Icon name="ph:info" class="text-2xl text-atunlu-blue shrink-0" />
                                Prioridad y Sorteos
                            </h3>
                            <p class="text-gray-700 leading-relaxed text-lg">
                                Tendrán prioridad aquellos afiliados que nunca utilizaron el servicio de hotelería. Si hay más de un afiliado inscripto para la misma semana se realizarán sorteos.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Destinos -->
        <section class="py-16 md:py-24 bg-gray-50 border-y border-gray-100">
            <div class="max-w-7xl mx-auto px-4 sm:px-6">
                <div class="text-center mb-12 md:mb-16 reveal">
                    <h2 class="text-3xl sm:text-4xl font-black text-atunlu-navy mb-4">
                        Destinos Disponibles
                    </h2>
                    <p class="text-gray-600 max-w-2xl mx-auto text-sm sm:text-base">
                        Alojamientos de primer nivel en distintos puntos del país.
                    </p>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-2 gap-8 reveal">
                    {destinos.map((destino) => (
                        <div class="bg-white rounded-[2.5rem] overflow-hidden border border-gray-100 shadow-sm hover:shadow-md transition-shadow flex flex-col group">
                            <!-- Espacio para foto -->
                            <div class="w-full h-64 sm:h-72 bg-gray-200 relative overflow-hidden">
                                <Image
                                    src={destino.imagen}
                                    alt={`Foto de ${destino.nombre}`}
                                    class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700"
                                />
                                <div class="absolute inset-0 bg-linear-to-t from-black/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
                            </div>
                            <!-- Contenido -->
                            <div class="p-8">
                                <div class="w-16 h-16 rounded-2xl bg-atunlu-blue/10 flex items-center justify-center mb-6">
                                    <Icon name={destino.icon} class="text-3xl text-atunlu-blue" />
                                </div>
                                <h3 class="text-2xl font-black text-atunlu-navy mb-2">
                                    {destino.nombre}
                                </h3>
                                <p class="text-gray-600 font-medium flex items-center gap-2">
                                    <Icon name="ph:map-pin" class="text-atunlu-blue text-lg shrink-0" />
                                    {destino.ubicacion}
                                </p>
                            </div>
                        </div>
                    ))}
                </div>
            </div>
        </section>

        <!-- Trámites y Tarifas -->
        <section class="py-24 relative z-0 bg-atunlu-navy pb-48">
            <div class="max-w-5xl mx-auto px-6 reveal relative z-10">
                <div class="bg-atunlu-navy text-white rounded-[2.5rem] p-8 md:p-14 relative overflow-hidden shadow-2xl">
                    
                    
                    <div class="relative z-10">
                        <h2 class="text-4xl font-black mb-10 flex items-center gap-4">
                            <Icon name="ph:files" class="text-atunlu-blue" />
                            Inscripción y Tarifas
                        </h2>
                        <ul class="space-y-8 text-xl text-blue-100/90 mb-12">
                            <li class="flex gap-4">
                                <span class="w-2 h-2 mt-3 rounded-full bg-atunlu-blue shrink-0"></span>
                                <p class="leading-relaxed">
                                    Los compañeros y compañeras de las sedes y centros regionales podrán descargar la planilla <strong>INGRESANDO ACÁ</strong> y enviarla por mail a <a href="mailto:atunlu@unlu.edu.ar" class="text-white font-bold underline hover:text-atunlu-blue transition-colors">atunlu@unlu.edu.ar</a>.
                                </p>
                            </li>
                            <li class="flex gap-4">
                                <span class="w-2 h-2 mt-3 rounded-full bg-atunlu-blue shrink-0"></span>
                                <p class="leading-relaxed">
                                    Más información sobre comodidades, tarifas y financiación puede solicitarse en la sede de ATUNLu.
                                </p>
                            </li>
                            <li class="flex gap-4">
                                <span class="w-2 h-2 mt-3 rounded-full bg-atunlu-blue shrink-0"></span>
                                <p class="leading-relaxed">
                                    Las reservas estarán sujetas a disponibilidad y la solicitud será confirmada por la Secretaría de Turismo y Recreación de la FATUN.
                                </p>
                            </li>
                        </ul>

                        <div class="flex flex-col sm:flex-row gap-4 sm:gap-6 mt-12">
                            <a
                                href="#"
                                class="px-8 py-5 bg-atunlu-blue text-white font-bold rounded-2xl hover:bg-white hover:text-atunlu-navy transition-all transform hover:-translate-y-1 shadow-xl shadow-blue-500/20 flex items-center justify-center gap-2"
                            >
                                <Icon name="ph:download-simple" class="text-2xl" />
                                Descargar Planilla
                            </a>
                            <a
                                href="#"
                                class="px-8 py-5 bg-white/10 text-white font-bold rounded-2xl border border-white/20 hover:bg-white/20 transition-all flex items-center justify-center gap-2 backdrop-blur-sm text-center"
                            >
                                <Icon name="ph:currency-circle-dollar" class="text-2xl shrink-0" />
                                <span>Ingresá acá para conocer<br class="hidden sm:block lg:hidden"/> las tarifas</span>
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Fondo SVG inferior -->
            <div
                class="absolute bottom-0 left-0 w-full pointer-events-none z-0"
                style="line-height: 0;"
            >
                <img
                    src={fondoDark.src}
                    alt=""
                    aria-hidden="true"
                    class="w-full block"
                />
            </div>
        </section>

    </main>
</Layout>
