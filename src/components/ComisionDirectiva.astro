        image: "",
    },
    {
        name: "VIERA, YARA SABRINA",
        role: "Secretaria de Hacienda y Finanzas",
        image: "",
    },
    {
        name: "MARAZZO, MARÍA BETINA",
        role: "Secretaria de Actas",
        image: "",
    },
    {
        name: "GONZÁLEZ BAEZ, SONIA GISELA",
        role: "Secretaria Administrativa",
        image: "",
    },
    {
        name: "MALDONADO, MARÍA CECILIA",
        role: "Secretaría de Prensa y Difusión",
        image: "",
    },
    {
        name: "TORRES, MATÍAS ALBERTO",
        role: "Subsecretaría de Prensa y Difusión",
        image: "",
    },
    {
        name: "SUÁREZ, GUADALUPE JAQUELINA",
        role: "Secretaria de Cultura, Deportes y Recreación",
        image: "",
    },
    {
        name: "LÓPEZ, SONIA KARINA",
        role: "Secretaria de Capacitación y Formación Profesional",
        image: "",
    },
    {
        name: "GONZÁLEZ, ANA LAURA",
        role: "Subsecretaria de Capacitación y Formación Profesional",
        image: "",
    },
    {
        name: "GIORGIO, MARÍA EUGENIA",
        role: "Secretaria de Derechos Humanos",
        image: "",
    },
    {
        name: "GONZÁLEZ, SANDRO AGUSTIN",
        role: "Secretaria de Relaciones Institucionales",
        image: "",
    },
    {
        name: "LEAL RAMIRO-GERMAN",
        role: "Secretaria de Juventud",
        image: "",
    },
    {
        name: "MIRANDA, JOSÉ LUIS",
        role: "Secretaria de Turismo y Acción social",
        image: "",
    },
    {
        name: "MAGGIOLO, CONSUELO",
        role: "Secretaria de Género",
