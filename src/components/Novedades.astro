---
import { Icon } from "astro-icon/components";
import { getCollection } from "astro:content";
import NovedadCard from "@components/NovedadCard.astro";
import fondoNovedad from "@assets/images/fondos/fondo-novedad.svg";
import notaCentral from "@assets/images/novedades/nota-central/nota-central.jpg";

const allNovedades = await getCollection("novedades", ({ data }) => {
    return data.draft !== true;
});

// Ordenar por fecha descendente y tomar las últimas 3
const latestNovedades = allNovedades
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
    .slice(0, 3);

const featuredNovedad = latestNovedades[0]
    ? {
          ...latestNovedades[0],
          data: { ...latestNovedades[0].data, image: notaCentral },
      }
    : null;
---

<section
    id="novedades"
    class="relative py-20 bg-slate-200 scroll-mt-5 overflow-hidden"
>
    <div class="max-w-7xl mx-auto px-6">
        <div
            class="flex flex-col md:flex-row md:justify-between md:items-end gap-6 mb-16 reveal"
        >
            <div class="space-y-4">
                <h2
                    class="text-5xl font-extrabold text-atunlu-navy tracking-tight"
                >
                    Últimas Novedades
                </h2>
                <p class="text-gray-500 font-medium text-xl text-pretty">
                    Toda la información sindical al día.
                </p>
            </div>
            <a
                href="/ultimas-novedades"
                class="flex items-center gap-2 text-atunlu-blue font-bold hover:gap-4 transition-all w-fit"
                >Ver todas <Icon name="ph:caret-right" /></a
            >
        </div>

        <div class="relative z-10 grid grid-cols-1 lg:grid-cols-12 gap-6">
            {
                featuredNovedad && (
                    <div class="lg:col-span-8">
                        <NovedadCard
                            novedad={featuredNovedad}
                            index={0}
                            isFeatured={true}
                        />
                    </div>
                )
            }
            <div class="lg:col-span-4 flex flex-col gap-6">
                {
                    latestNovedades
                        .slice(1)
                        .map((novedad, index) => (
                            <NovedadCard novedad={novedad} index={index + 1} />
                        ))
                }
            </div>
        </div>
    </div>

    <!-- SVG decorativo: ocupa todo el ancho, pegado al fondo de la sección -->
    <img
        src={fondoNovedad.src}
        alt=""
        aria-hidden="true"
        class="absolute bottom-0 left-0 w-full pointer-events-none select-none"
    />
</section>
