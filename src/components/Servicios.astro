---
import { Icon } from "astro-icon/components";

const servicios = [
    {
        title: "Turismo",
        icon: "airplane-tilt",
        description:
            "Accedé a nuestros hoteles en las mejores plazas turísticas del país con tarifas diferenciales.",
        link: "#",
        linkText: "Explorar",
    },
    {
        title: "Deportes",
        icon: "trophy",
        description:
            "Participá de torneos deportivos, olimpiadas y actividades físicas pensadas para el bienestar del afiliado.",
        link: "#",
        linkText: "Explorar",
    },
    {
        title: "Cultura",
        icon: "palette",
        description:
            "Talleres artísticos, eventos culturales y salidas recreativas para fomentar la integración y el ocio.",
        link: "#",
        linkText: "Explorar",
    },
    {
        title: "Capacitación",
        icon: "graduation-cap",
        description:
            "Formación continua certificada para tu crecimiento profesional dentro de la estructura UNLu.",
        link: "#",
        linkText: "Cursos",
    },
    {
        title: "Predio",
        icon: "house",
        description:
            "Nuestro espacio recreativo con parrillas y salones para el uso exclusivo de la familia nodocente.",
        link: "/predio",
        linkText: "Conocer",
    },
    {
        title: "Convenios",
        icon: "handshake",
        description:
            "Descuentos especiales y planes preferenciales en una amplia red de comercios y servicios locales.",
        link: "#",
        linkText: "Ver todos",
    },
    {
        title: "Beneficios",
        icon: "gift",
        description:
            "Accedé a subsidios, kits escolares, préstamos y diversos programas de asistencia para el afiliado.",
        link: "/beneficios",
        linkText: "Beneficios",
    },
];

const duplicatedServicios = [...servicios, ...servicios, ...servicios];
---

<section
    id="servicios"
    class="py-32 bg-atunlu-navy text-white relative overflow-hidden"
>
    <div class="max-w-7xl mx-auto px-6">
        <div class="text-center max-w-3xl mx-auto mb-20 reveal">
            <h2 class="text-5xl font-extrabold mb-6 tracking-tight">
                Servicios & Beneficios
            </h2>
            <p class="text-blue-100/50 text-xl">
                Potenciando tu bienestar y el de tu familia.
            </p>
        </div>

        <div
            class="relative py-4 -mx-6 md:-mx-12 px-6 md:px-12 overflow-hidden slider-mask"
        >
            <div
                class="flex animate-infinite-scroll hover:[animation-play-state:paused] gap-8 w-max"
            >
                {
                    duplicatedServicios.map((servicio) => (
                        <div class="w-[350px] md:w-[400px] shrink-0 group bg-white/5 border border-white/10 p-10 rounded-[2.5rem] hover:bg-atunlu-blue transition-all duration-500">
                            <div class="w-16 h-16 bg-atunlu-blue group-hover:bg-white rounded-2xl flex items-center justify-center mb-8 transition-colors">
                                <Icon
                                    name={`ph:${servicio.icon}`}
                                    class="text-3xl text-white group-hover:text-atunlu-blue"
                                />
                            </div>
                            <h3 class="text-2xl font-bold mb-4">
                                {servicio.title}
                            </h3>
                            <p class="text-blue-100/60 group-hover:text-white/80 leading-relaxed mb-8">
                                {servicio.description}
                            </p>
                            <a
                                href={servicio.link}
                                class="inline-flex items-center gap-2 font-bold text-atunlu-blue group-hover:text-white transition-colors"
                            >
                                {servicio.linkText}{" "}
                                <Icon name="ph:arrow-right" />
                            </a>
                        </div>
                    ))
                }
            </div>
        </div>
    </div>
</section>

<style>
    .slider-mask {
        mask-image: linear-gradient(
            to right,
            transparent 0%,
            rgba(0, 0, 0, 0.4) 10%,
            black 20%,
            black 80%,
            rgba(0, 0, 0, 0.4) 90%,
            transparent 100%
        );
        -webkit-mask-image: linear-gradient(
            to right,
            transparent 0%,
            rgba(0, 0, 0, 0.4) 10%,
            black 20%,
            black 80%,
            rgba(0, 0, 0, 0.4) 90%,
            transparent 100%
        );
    }

    .animate-infinite-scroll {
        will-change: transform;
        /* Sin animación CSS — el movimiento lo maneja JS */
    }
</style>

<script>
    const track = document.querySelector(
        ".animate-infinite-scroll",
    ) as HTMLElement;
    if (track) {
        let position = 0;
        let paused = false;
        let rafId: number;
        const speed = 2;

        // Se calcula una sola vez y se actualiza solo si cambia el tamaño
        let loopWidth = track.scrollWidth / 3;

        const resizeObserver = new ResizeObserver(() => {
            loopWidth = track.scrollWidth / 3;
        });
        resizeObserver.observe(track);

        function tick() {
            if (!paused) {
                position += speed;
                if (position >= loopWidth) position -= loopWidth;
                track.style.transform = `translateX(-${position}px)`;
            }
            rafId = requestAnimationFrame(tick);
        }

        // Pausa cuando el carrusel sale del viewport
        const intersectionObserver = new IntersectionObserver(
            ([entry]) => {
                if (entry.isIntersecting) {
                    rafId = requestAnimationFrame(tick);
                } else {
                    cancelAnimationFrame(rafId);
                }
            },
            { threshold: 0 },
        );
        intersectionObserver.observe(track);

        track.addEventListener("mouseenter", () => (paused = true));
        track.addEventListener("mouseleave", () => (paused = false));
    }
</script>
