---
import { Image } from "astro:assets";

interface Props {
    novedad: any;
    index: number;
    isFeatured?: boolean;
}

const { novedad, index, isFeatured = false } = Astro.props;

const formatDate = (date: Date) => {
    return date
        .toLocaleDateString("es-ES", {
            day: "2-digit",
            month: "long",
            year: "numeric",
        })
        .toUpperCase();
};
---

<a
    href={`/novedades/${novedad.id}`}
    class:list={[
        "bg-white rounded-[2.5rem] overflow-hidden card-hover border border-blue-200 reveal zoom-in block group/card",
        isFeatured ? "md:flex md:flex-row h-full" : "flex flex-col h-full",
    ]}
    style={`transition-delay: ${index * 150}ms;`}
>
    <div
        class:list={[
            "overflow-hidden relative group",
            isFeatured ? "md:w-1/2 h-64 md:h-auto" : "h-40",
        ]}
    >
        <Image
            src={novedad.data.image}
            class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110 group-hover/card:scale-110"
            alt={novedad.data.imageAlt}
        />
        <span
            class="absolute bottom-6 left-6 bg-white/90 backdrop-blur px-4 py-1.5 rounded-full text-[10px] font-black uppercase text-atunlu-navy"
        >
            {novedad.data.category}
        </span>
    </div>
    <div
        class:list={[
            "flex flex-col justify-between",
            isFeatured ? "p-8 md:p-10 md:w-1/2" : "p-6 grow",
        ]}
    >
        <div>
            <time class="text-xs font-bold text-gray-400">
                {formatDate(novedad.data.date)}
            </time>
            <h3
                class:list={[
                    "font-bold text-atunlu-navy mt-1 leading-tight",
                    isFeatured ? "text-2xl md:text-3xl mb-4" : "text-xl mb-4",
                ]}
            >
                {novedad.data.title}
            </h3>
            {
                isFeatured && (
                    <p class="text-gray-500 text-base mb-6 line-clamp-2">
                        {novedad.data.description}
                    </p>
                )
            }
        </div>
        <div
            class="w-12 h-12 bg-gray-50 rounded-full flex items-center justify-center text-atunlu-blue transition-all self-start group-hover/card:bg-atunlu-blue group-hover/card:text-white"
        >
            <i class="ph ph-arrow-up-right font-bold"></i>
        </div>
    </div>
</a>
