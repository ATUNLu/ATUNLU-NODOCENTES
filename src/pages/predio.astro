---
import Layout from "@layouts/Layout.astro";
import { Icon } from "astro-icon/components";

const preciosSemanales = [
    {
        horario: "Sábados, domingos y feriados (diurno)",
        subtitulo: "11:00 a 17:00 hs",
        items: [
            { lugar: "SUM", familiar: "$100.000", otros: "$800.000" },
            { lugar: "Quincho", familiar: "$75.000", otros: "$500.000" },
        ],
    },
    {
        horario: "Viernes, sábados y víspera de feriado (nocturno)",
        subtitulo: "20:00 a 04:00 hs",
        items: [
            { lugar: "SUM", familiar: "$100.000", otros: "$800.000" },
            { lugar: "Quincho", familiar: "$75.000", otros: "$500.000" },
        ],
    },
];

const preciosSemanaNocturno = [
    {
        horario: "Domingos a jueves (nocturno)",
        subtitulo: "21:00 a 01:00 hs",
        items: [
            { lugar: "SUM", familiar: "$75.000", otros: "$400.000" },
            { lugar: "Quincho", familiar: "$54.000", otros: "$300.000" },
        ],
    },
];

const preciosSemanaTarde = [
    {
        horario: "Lunes a jueves (tarde)",
        subtitulo: "16:00 a 19:00 hs",
        items: [
            { lugar: "SUM", familiar: "$54.000", otros: "$250.000" },
            { lugar: "Quincho", familiar: "$48.000", otros: "$100.000" },
        ],
    },
];

const servicios = [
    { icon: "ph:copyright", label: "AADI – CAPIF" },
    { icon: "ph:thermometer-simple", label: "Ambiente climatizado" },
    { icon: "ph:wifi-high", label: "Internet WiFi" },
    { icon: "ph:chair", label: "Mesas y sillas" },
    { icon: "ph:monitor", label: "Pantalla de video (3 x 2 mts)" },
    { icon: "ph:snowflake", label: "Heladeras y freezer" },
    { icon: "ph:cooking-pot", label: "Cocina industrial y micro" },
    { icon: "ph:drop", label: "Agua caliente" },
    { icon: "ph:tree", label: "Amplio parque y juegos" },
    { icon: "ph:car", label: "Estacionamiento" },
    { icon: "ph:soccer-ball", label: "Cancha (solicitar)" },
];
---

<Layout title="Predio | ATUNLu" isOpaque={true}>
    <main class="pt-20 overflow-hidden">
        <!-- Hero Section -->
        <section class="relative py-24 bg-atunlu-navy overflow-hidden">
            <div class="absolute inset-0 opacity-10">
                <div
                    class="absolute inset-0 bg-[radial-gradient(circle_at_50%_50%,rgba(37,99,235,0.4),transparent_70%)]"
                >
                </div>
            </div>
            <div class="max-w-7xl mx-auto px-6 relative z-10 text-center">
                <div
                    class="inline-block w-20 h-1.5 bg-atunlu-blue rounded-full mb-8 reveal"
                >
                </div>
                <h1
                    class="text-5xl md:text-7xl font-black text-white leading-[1.1] tracking-tight mb-6 reveal"
                >
                    Predio ATUNLu
                </h1>
                <p
                    class="text-xl text-blue-100/80 max-w-2xl mx-auto leading-relaxed reveal text-pretty"
                >
                    Espacios totalmente equipados para disfrutar con familia y
                    colegas.
                </p>
            </div>
        </section>

        <!-- Intro Content -->
        <section class="py-24 bg-white">
            <div class="max-w-7xl mx-auto px-6">
                <div class="grid grid-cols-1 lg:grid-cols-2 gap-20 items-start">
                    <!-- Left: Info -->
                    <div class="space-y-10 reveal">
                        <div class="prose prose-xl prose-slate">
                            <h2
                                class="text-4xl font-extrabold text-atunlu-navy leading-tight"
                            >
                                Tu lugar de encuentro
                            </h2>
                            <p class="text-gray-600 leading-relaxed text-lg">
                                ATUNLu tiene a disposición de los afiliados el
                                predio del sindicato, con un salón de usos
                                múltiples (SUM) y un quincho totalmente
                                equipados para todo tipo de eventos y
                                celebraciones.
                            </p>

                            <div
                                class="bg-atunlu-lightBlue/30 p-8 rounded-3xl border-l-8 border-atunlu-blue mt-12"
                            >
                                <h3
                                    class="text-xl text-atunlu-navy font-bold flex items-center gap-3 mb-4"
                                >
                                    <Icon
                                        name="ph:warning-circle"
                                        class="text-2xl text-atunlu-blue shrink-0"
                                    />
                                    Importante
                                </h3>
                                <p class="text-gray-700 leading-relaxed">
                                    El uso de estos espacios implica una
                                    contribución que varía según se trate de:
                                </p>
                                <ul
                                    class="mt-4 space-y-2 text-gray-700 font-medium text-base lg:text-xl"
                                >
                                    <li class="flex items-center gap-2">
                                        <Icon
                                            name="ph:check"
                                            class="text-atunlu-blue text-xl shrink-0"
                                        />
                                        Afiliado, cónyuge, hijos, padre/madre (1er
                                        grado)
                                    </li>
                                    <li class="flex items-center gap-2">
                                        <Icon
                                            name="ph:check"
                                            class="text-atunlu-blue text-xl shrink-0"
                                        />
                                        Otros familiares
                                    </li>
                                </ul>
                            </div>

                            <div class="mt-8">
                                <a
                                    href="#"
                                    class="inline-flex items-center justify-center gap-2 px-8 py-4 bg-atunlu-blue text-white font-bold rounded-2xl hover:bg-atunlu-navy transition-all shadow-lg hover:shadow-xl btn-shine"
                                >
                                    <Icon
                                        name="ph:download-simple"
                                        class="text-xl"
                                    />
                                    Descargar Formulario
                                </a>
                            </div>
                        </div>
                    </div>

                    <!-- Right: Capacity & Spaces -->
                    <div class="grid grid-cols-1 gap-8 reveal">
                        <div
                            class="bg-gray-50 p-8 rounded-[2.5rem] border border-gray-100 shadow-sm hover:shadow-md transition-shadow"
                        >
                            <div
                                class="w-16 h-16 rounded-2xl bg-atunlu-blue/10 flex items-center justify-center mb-6"
                            >
                                <Icon
                                    name="ph:house"
                                    class="text-3xl text-atunlu-blue"
                                />
                            </div>
                            <h3
                                class="text-2xl font-black text-atunlu-navy mb-2"
                            >
                                SUM
                            </h3>
                            <p class="text-gray-600 mb-6 font-medium">
                                Salón de Usos Múltiples
                            </p>
                            <div
                                class="flex items-center gap-3 text-atunlu-blue font-bold text-xl"
                            >
                                <Icon name="ph:users" />
                                Hasta 120 personas
                            </div>
                        </div>

                        <div
                            class="bg-gray-50 p-8 rounded-[2.5rem] border border-gray-100 shadow-sm hover:shadow-md transition-shadow"
                        >
                            <div
                                class="w-16 h-16 rounded-2xl bg-atunlu-navy/10 flex items-center justify-center mb-6"
                            >
                                <Icon
                                    name="ph:users-four"
                                    class="text-3xl text-atunlu-navy"
                                />
                            </div>
                            <h3
                                class="text-2xl font-black text-atunlu-navy mb-2"
                            >
                                Quincho
                            </h3>
                            <p class="text-gray-600 mb-6 font-medium">
                                Espacio parrillero
                            </p>
                            <div
                                class="flex items-center gap-3 text-atunlu-navy font-bold text-xl"
                            >
                                <Icon name="ph:users" />
                                Hasta 60 personas
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Pricing Tables -->
        <section class="py-16 md:py-24 bg-gray-50 border-y border-gray-100">
            <div class="max-w-7xl mx-auto px-4 sm:px-6">
                <div class="text-center mb-12 md:mb-16 reveal">
                    <h2
                        class="text-3xl sm:text-4xl font-black text-atunlu-navy mb-4"
                    >
                        Contribuciones
                    </h2>
                    <p
                        class="text-gray-600 max-w-2xl mx-auto text-sm sm:text-base"
                    >
                        Valores vigentes sujetos a horarios y parentesco.
                    </p>
                </div>

                <div class="grid grid-cols-1 gap-8 md:gap-12">
                    <!-- Day/Night Weekend -->
                    <div
                        class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6 md:gap-8 reveal"
                    >
                        {
                            preciosSemanales.map((seccion) => (
                                <div class="bg-white p-5 sm:p-8 rounded-3xl border border-gray-100 shadow-sm">
                                    <div class="mb-5 md:mb-6">
                                        <h3 class="text-lg sm:text-xl font-bold text-atunlu-navy flex items-center gap-2">
                                            <Icon
                                                name="ph:calendar-blank"
                                                class="text-atunlu-blue shrink-0"
                                            />
                                            {seccion.horario}
                                        </h3>
                                        <p class="text-atunlu-blue font-medium mt-1 text-sm sm:text-base">
                                            {seccion.subtitulo}
                                        </p>
                                    </div>

                                    {/* Mobile: card layout */}
                                    <div class="flex flex-col divide-y divide-gray-100 sm:hidden">
                                        {seccion.items.map((item) => (
                                            <div class="py-3 grid grid-cols-2 gap-x-2">
                                                <div class="col-span-2 font-bold text-atunlu-navy text-sm mb-1">
                                                    {item.lugar}
                                                </div>
                                                <div>
                                                    <span class="text-xs text-gray-400 uppercase tracking-wide block mb-0.5">
                                                        Afiliado / 1° Grado
                                                    </span>
                                                    <span class="text-atunlu-blue font-bold text-sm">
                                                        {item.familiar}
                                                    </span>
                                                </div>
                                                <div>
                                                    <span class="text-xs text-gray-400 uppercase tracking-wide block mb-0.5">
                                                        Otros
                                                    </span>
                                                    <span class="text-gray-600 font-medium text-sm">
                                                        {item.otros}
                                                    </span>
                                                </div>
                                            </div>
                                        ))}
                                    </div>

                                    {/* Desktop: table layout */}
                                    <div class="hidden sm:block overflow-x-auto">
                                        <table class="w-full text-left">
                                            <thead>
                                                <tr class="text-xs text-gray-400 font-bold uppercase tracking-wider">
                                                    <th class="pb-4">Lugar</th>
                                                    <th class="pb-4">
                                                        Afiliado / 1° Grado
                                                    </th>
                                                    <th class="pb-4">Otros</th>
                                                </tr>
                                            </thead>
                                            <tbody class="divide-y divide-gray-50">
                                                {seccion.items.map((item) => (
                                                    <tr>
                                                        <td class="py-4 font-bold text-atunlu-navy text-sm">
                                                            {item.lugar}
                                                        </td>
                                                        <td class="py-4 text-atunlu-blue font-bold text-sm">
                                                            {item.familiar}
                                                        </td>
                                                        <td class="py-4 text-gray-600 font-medium text-sm">
                                                            {item.otros}
                                                        </td>
                                                    </tr>
                                                ))}
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            ))
                        }
                    </div>

                    <!-- Week Night & Afternoon -->
                    <div
                        class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6 md:gap-8 reveal"
                    >
                        {
                            [
                                ...preciosSemanaNocturno,
                                ...preciosSemanaTarde,
                            ].map((seccion) => (
                                <div class="bg-white p-5 sm:p-8 rounded-3xl border border-gray-100 shadow-sm">
                                    <div class="mb-5 md:mb-6">
                                        <h3 class="text-lg sm:text-xl font-bold text-atunlu-navy flex items-center gap-2">
                                            <Icon
                                                name={
                                                    seccion.horario.includes(
                                                        "nocturno",
                                                    )
                                                        ? "ph:moon"
                                                        : "ph:sun"
                                                }
                                                class="text-atunlu-blue shrink-0"
                                            />
                                            {seccion.horario}
                                        </h3>
                                        <p class="text-atunlu-blue font-medium mt-1 text-sm sm:text-base">
                                            {seccion.subtitulo}
                                        </p>
                                    </div>

                                    {/* Mobile: card layout */}
                                    <div class="flex flex-col divide-y divide-gray-100 sm:hidden">
                                        {seccion.items.map((item) => (
                                            <div class="py-3 grid grid-cols-2 gap-x-2">
                                                <div class="col-span-2 font-bold text-atunlu-navy text-sm mb-1">
                                                    {item.lugar}
                                                </div>
                                                <div>
                                                    <span class="text-xs text-gray-400 uppercase tracking-wide block mb-0.5">
                                                        Afiliado / 1° Grado
                                                    </span>
                                                    <span class="text-atunlu-blue font-bold text-sm">
                                                        {item.familiar}
                                                    </span>
                                                </div>
                                                <div>
                                                    <span class="text-xs text-gray-400 uppercase tracking-wide block mb-0.5">
                                                        Otros
                                                    </span>
                                                    <span class="text-gray-600 font-medium text-sm">
                                                        {item.otros}
                                                    </span>
                                                </div>
                                            </div>
                                        ))}
                                    </div>

                                    {/* Desktop: table layout */}
                                    <div class="hidden sm:block overflow-x-auto">
                                        <table class="w-full text-left">
                                            <thead>
                                                <tr class="text-xs text-gray-400 font-bold uppercase tracking-wider">
                                                    <th class="pb-4">Lugar</th>
                                                    <th class="pb-4">
                                                        Afiliado / 1° Grado
                                                    </th>
                                                    <th class="pb-4">Otros</th>
                                                </tr>
                                            </thead>
                                            <tbody class="divide-y divide-gray-50">
                                                {seccion.items.map((item) => (
                                                    <tr>
                                                        <td class="py-4 font-bold text-atunlu-navy text-sm">
                                                            {item.lugar}
                                                        </td>
                                                        <td class="py-4 text-atunlu-blue font-bold text-sm">
                                                            {item.familiar}
                                                        </td>
                                                        <td class="py-4 text-gray-600 font-medium text-sm">
                                                            {item.otros}
                                                        </td>
                                                    </tr>
                                                ))}
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            ))
                        }
                    </div>
                </div>
            </div>
        </section>

        <!-- Services -->
        <section class="py-24 md:py-32 bg-white">
            <div class="max-w-7xl mx-auto px-4 sm:px-6">
                <div class="text-center mb-16 md:mb-20 reveal">
                    <h2
                        class="text-3xl sm:text-4xl font-black text-atunlu-navy mb-4"
                    >
                        Servicios Incluidos
                    </h2>
                    <p
                        class="text-gray-600 max-w-2xl mx-auto text-pretty text-sm sm:text-base"
                    >
                        Todo lo necesario para que tu evento sea un éxito.
                    </p>
                </div>

                <div
                    class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4 md:gap-6 reveal"
                >
                    {
                        servicios.map((s) => (
                            <div class="flex items-center gap-3 sm:gap-4 p-3 sm:p-4 rounded-2xl hover:bg-atunlu-lightBlue/10 transition-colors">
                                <div class="w-10 h-10 sm:w-12 sm:h-12 bg-atunlu-blue/5 flex items-center justify-center rounded-xl shrink-0">
                                    <Icon
                                        name={s.icon}
                                        class="text-xl sm:text-2xl text-atunlu-blue"
                                    />
                                </div>
                                <span class="font-bold text-atunlu-navy text-sm sm:text-base leading-tight">
                                    {s.label}
                                </span>
                            </div>
                        ))
                    }
                </div>
            </div>
        </section>

        <!-- Considerations -->
        <section
            class="py-24 bg-atunlu-navy text-white relative overflow-hidden"
        >
            <div
                class="absolute right-0 top-0 w-1/3 h-full bg-atunlu-blue/10 skew-x-12 translate-x-20"
            >
            </div>
            <div class="max-w-7xl mx-auto px-6 relative z-10">
                <div class="max-w-3xl reveal">
                    <h2
                        class="text-4xl font-black mb-12 flex items-center gap-4"
                    >
                        <Icon name="ph:info" class="text-atunlu-blue" />
                        Consideraciones
                    </h2>
                    <ul class="space-y-6 text-xl text-blue-100/80">
                        <li class="flex gap-4">
                            <span
                                class="w-2 h-2 mt-3 rounded-full bg-atunlu-blue shrink-0"
                            ></span>
                            Traer parlante o contar con Spotify para la música.
                        </li>
                        <li class="flex gap-4">
                            <span
                                class="w-2 h-2 mt-3 rounded-full bg-atunlu-blue shrink-0"
                            ></span>
                            Completar planilla de reserva del predio en nuestras oficinas.
                        </li>
                        <li class="flex gap-4">
                            <span
                                class="w-2 h-2 mt-3 rounded-full bg-atunlu-blue shrink-0"
                            ></span>
                            Cumplir con el protocolo sanitario vigente.
                        </li>
                    </ul>

                    <div class="mt-16 flex flex-wrap gap-6">
                        <a
                            href="/#contacto"
                            class="px-10 py-5 bg-atunlu-blue text-white font-black rounded-2xl hover:bg-white hover:text-atunlu-navy transition-all transform hover:-translate-y-1 shadow-xl shadow-blue-500/20"
                        >
                            Reservar ahora
                        </a>
                        <a
                            href="#"
                            class="px-10 py-5 bg-white/10 text-white font-bold rounded-2xl border border-white/20 hover:bg-white/20 transition-all backdrop-blur-sm"
                        >
                            Planilla de Reserva
                        </a>
                    </div>
                </div>
            </div>
        </section>

        <!-- Final CTA -->
        <section class="py-24 bg-white border-t border-gray-100">
            <div class="max-w-4xl mx-auto px-6 text-center reveal">
                <h2 class="text-3xl font-extrabold text-atunlu-navy mb-8">
                    ¿Tenés dudas sobre el predio?
                </h2>
                <p class="text-xl text-gray-600 mb-10 text-pretty">
                    Estamos para asesorarte sobre la disponibilidad y el
                    equipamiento. No dudes en consultarnos.
                </p>
            </div>
        </section>
    </main>
</Layout>
