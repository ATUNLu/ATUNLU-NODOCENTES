---
import { Image } from "astro:assets";
import hero1 from "../assets/images/hero/hero-1.jpg";
import hero2 from "../assets/images/hero/hero-2.jpg";
import hero3 from "../assets/images/hero/hero-3.jpg";

const images = [hero1, hero2, hero3];
---

<section
    id="inicio"
    class="relative min-h-screen flex items-center overflow-hidden"
>
    <div class="absolute inset-0 z-0 bg-slate-900 overflow-hidden">
        {
            images.map((img, index) => (
                <Image
                    src={img}
                    class={`w-full h-full object-cover absolute inset-0 transition-opacity duration-1500 ease-in-out hero-slide ${index === 0 ? "opacity-100 active" : "opacity-0"}`}
                    alt={`Fondo de inicio ${index + 1}`}
                    loading={index === 0 ? "eager" : "lazy"}
                />
            ))
        }
        <div class="absolute inset-0 hero-overlay"></div>

        <!-- Progress Bar -->
        <div
            class="absolute bottom-0 left-0 w-full h-1 bg-white/10 z-20 overflow-hidden"
        >
            <div
                id="hero-progress"
                class="h-full bg-atunlu-blue/80 w-0 transition-none"
            >
            </div>
        </div>
    </div>

    <div
        class="relative z-10 max-w-7xl mx-auto px-6 text-white text-center md:text-left"
    >
        <div class="max-w-2xl space-y-6">
            <span
                class="inline-block px-4 py-1 rounded-full bg-blue-500/20 backdrop-blur-md border border-white/20 text-[10px] font-black uppercase tracking-[0.2em]"
            >
                Sindicato de Base FATUN
            </span>
            <h1
                class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl xl:text-8xl font-extrabold leading-tight md:leading-[1.05] tracking-tighter"
            >
                Unidad, Solidaridad <span class="text-atunlu-blue">y</span> Organización
            </h1>
            <p
                class="text-xl md:text-2xl font-light text-blue-50 opacity-90 text-balance"
            >
                Defendiendo los derechos de las Trabajadoras y los Trabajadores
                Nodocentes de la Universidad Nacional de Luján.
            </p>
            <div class="flex flex-col sm:flex-row gap-4 pt-8">
                <a
                    href="/#novedades"
                    class="btn-shine px-8 py-4 bg-atunlu-blue text-white font-bold rounded shadow-xl flex items-center justify-center gap-2 hover:-translate-y-1 transition-all duration-300"
                >
                    NOVEDADES <i class="ph ph-arrow-right"></i>
                </a>
                <a
                    href="/#servicios"
                    class="px-8 py-4 bg-white/10 backdrop-blur-sm border border-white/30 text-white font-bold rounded flex items-center justify-center hover:bg-white/20 transition-all"
                >
                    SERVICIOS
                </a>
            </div>
        </div>
    </div>

    <!-- Navigation Dots -->
    <div
        class="absolute right-8 top-1/2 -translate-y-1/2 flex flex-col gap-4 z-20"
    >
        {
            images.map((_, index) => (
                <button
                    class={`hero-dot w-2 h-8 rounded-full transition-all duration-300 ${index === 0 ? "bg-atunlu-blue h-12" : "bg-white/30 hover:bg-white/50"}`}
                    aria-label={`Ir a slide ${index + 1}`}
                    data-index={index}
                />
            ))
        }
    </div>

    <!-- Scroll Indicator -->
    <div
        class="absolute bottom-10 left-1/2 -translate-x-1/2 text-white animate-bounce opacity-50"
    >
        <i class="ph ph-caret-double-down text-2xl"></i>
    </div>
</section>

<style>
    .hero-slide {
        transform: scale(1.1);
        transition:
            opacity 1.5s ease-in-out,
            transform 10s linear;
    }

    .hero-slide.active {
        transform: scale(1);
    }
</style>

<script>
    const SLIDE_DURATION = 6000; // 6 seconds

    const setupSlider = () => {
        const slides = document.querySelectorAll(".hero-slide");
        const dots = document.querySelectorAll(".hero-dot");
        const progressBar = document.getElementById("hero-progress");
        let currentSlide = 0;
        let timer: ReturnType<typeof setInterval>;
        let progressInterval: ReturnType<typeof setInterval>;

        if (!slides.length || !dots.length || !progressBar) return;

        const updateProgress = () => {
            let start = Date.now();
            if (progressInterval) clearInterval(progressInterval);

            progressBar.style.width = "0%";
            progressBar.style.transition = "none";

            progressInterval = setInterval(() => {
                const elapsed = Date.now() - start;
                const progress = Math.min(
                    (elapsed / SLIDE_DURATION) * 100,
                    100,
                );
                progressBar.style.width = `${progress}%`;

                if (progress >= 100) clearInterval(progressInterval);
            }, 16);
        };

        const goToSlide = (index: number) => {
            if (index === currentSlide) return;

            // Remove active from current
            slides[currentSlide].classList.remove("opacity-100", "active");
            slides[currentSlide].classList.add("opacity-0");
            dots[currentSlide].classList.remove("bg-atunlu-blue", "h-12");
            dots[currentSlide].classList.add("bg-white/30");

            // Set new current
            currentSlide = index;

            // Add active to new
            slides[currentSlide].classList.remove("opacity-0");
            slides[currentSlide].classList.add("opacity-100", "active");
            dots[currentSlide].classList.remove("bg-white/30");
            dots[currentSlide].classList.add("bg-atunlu-blue", "h-12");

            resetTimer();
        };

        const resetTimer = () => {
            if (timer) clearInterval(timer);
            updateProgress();
            timer = setInterval(() => {
                const next = (currentSlide + 1) % slides.length;
                goToSlide(next);
            }, SLIDE_DURATION);
        };

        // Click on dots
        dots.forEach((dot, index) => {
            dot.addEventListener("click", () =>
                goToSlide(parseInt((dot as HTMLElement).dataset.index || "0")),
            );
        });

        // Initialize first slide state
        slides[0].classList.add("active");
        resetTimer();

        // Return cleanup
        return () => {
            clearInterval(timer);
            clearInterval(progressInterval);
        };
    };

    let cleanup: (() => void) | undefined;

    // Run on initial load
    cleanup = setupSlider();

    // Support for Astro View Transitions (if used with after-swap)
    document.addEventListener("astro:after-swap", () => {
        if (cleanup) cleanup();
        cleanup = setupSlider();
    });

    // Also support page-load for initial and subsequent navigations
    document.addEventListener("astro:page-load", () => {
        if (cleanup) cleanup();
        cleanup = setupSlider();
    });
</script>
