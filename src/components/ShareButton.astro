<div class="relative inline-block">
    <button
        id="share-button"
        title="Compartir"
        class="w-12 h-12 bg-atunlu-blue text-white rounded-full flex items-center justify-center shadow-lg hover:scale-110 active:scale-95 transition-all group"
    >
        <i class="ph ph-share-network text-2xl"></i>
    </button>

    <div
        id="copy-toast"
        class="absolute bottom-full left-1/2 -translate-x-1/2 mb-4 px-4 py-2 bg-atunlu-navy text-white text-xs font-bold rounded-xl opacity-0 translate-y-2 pointer-events-none transition-all duration-300 shadow-xl border border-white/10"
    >
        ¡Copiado!
    </div>
</div>

<script>
    const shareBtn = document.getElementById("share-button");
    const copyToast = document.getElementById("copy-toast");

    if (shareBtn) {
        shareBtn.addEventListener("click", async () => {
            const shareData = {
                title: document.title,
                text: "Mirá esta novedad de ATUNLu:",
                url: window.location.href,
            };

            if (navigator.share && navigator.canShare(shareData)) {
                try {
                    await navigator.share(shareData);
                } catch (err) {
                    console.error("Error sharing:", err);
                }
            } else {
                // Fallback to clipboard
                try {
                    await navigator.clipboard.writeText(window.location.href);

                    // Show toast
                    if (copyToast) {
                        copyToast.classList.remove(
                            "opacity-0",
                            "translate-y-2",
                        );
                        copyToast.classList.add("opacity-100", "translate-y-0");

                        setTimeout(() => {
                            copyToast.classList.add(
                                "opacity-0",
                                "translate-y-2",
                            );
                            copyToast.classList.remove(
                                "opacity-100",
                                "translate-y-0",
                            );
                        }, 2000);
                    }
                } catch (err) {
                    console.error("Failed to copy: ", err);
                }
            }
        });
    }
</script>
