---
import { Image } from "astro:assets";
import atunluPleno from "@assets/images/iconos/atunlu-pleno.svg";
import fatunFooter from "@assets/images/iconos/fatun-footer.png";
import logoCgtra from "@assets/images/iconos/logo_cgtra.png";
import instagramIcon from "@assets/images/iconos/instagram-icon.svg";
import facebookIcon from "@assets/images/iconos/facebook-icon.svg";
import xIcon from "@assets/images/iconos/x_dark.svg";
import youtubeIcon from "@assets/images/iconos/youtube.svg";
const footerSections = [
    {
        title: "Sindicato",
        links: [
            { label: "Afiliación", href: "/afiliacion" },
            { label: "Convenio Colectivo", href: "/" },
            { label: "Escala Salarial", href: "/" },
            { label: "Institucional", href: "/#institucional" },
            { label: "Normativa", href: "/" },
        ],
    },
    {
        title: "Sedes",
        links: [
            { label: "Sede Luján", href: "#" },
            { label: "Sede San Miguel", href: "#" },
            { label: "Centro Regional Campana", href: "#" },
            { label: "Centro Regional Chivilcoy", href: "#" },
        ],
    },
];

const socialLinks = [
    { icon: instagramIcon, href: "https://www.instagram.com/atunlu.oficial/" },
    { icon: facebookIcon, href: "https://www.facebook.com/NodocentesUNLu/" },
    {
        icon: youtubeIcon,
        href: "https://www.youtube.com/channel/UCTb1knJ12I2bq3CNc8u5iPA/videos",
    },
    { icon: xIcon, href: "https://twitter.com/ATUNLuok" },
];
---

<footer class="bg-atunlu-dark text-white pt-24 pb-12 mt-auto">
    <div class="max-w-7xl mx-auto px-6">
        <div class="mb-16">
            <p
                class="text-center text-gray-500 text-[10px] uppercase tracking-[0.3em] mb-6 font-black text-pretty"
            >
                Descubrí más contenido en nuestras redes
            </p>
            <div class="flex justify-center gap-6 mb-6">
                {
                    socialLinks.map((social) => (
                        <a
                            href={social.href}
                            class="w-16 h-16 rounded-2xl bg-white/5 flex items-center justify-center hover:bg-atunlu-blue transition-all duration-300"
                        >
                            <img
                                src={social.icon.src}
                                alt=""
                                class="w-8 h-8 object-contain"
                            />
                        </a>
                    ))
                }
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-4 gap-16 mb-20">
            <div class="space-y-8">
                <div class="flex items-center gap-6">
                    <a href="/" class="block">
                        <img
                            src={atunluPleno.src}
                            alt="ATUNLu Logo"
                            class="h-12 w-auto"
                        />
                    </a>
                    <a href="https://www.fatun.org.ar/" target="_blank">
                        <Image
                            src={fatunFooter}
                            alt="FATUN Logo"
                            class="h-22 w-auto object-contain"
                        />
                    </a>
                    <a href="https://cgtoficial.org/" target="_blank">
                        <Image
                            src={logoCgtra}
                            alt="CGT Logo"
                            class="h-22 w-auto object-contain"
                        />
                    </a>
                </div>
                <p class="text-gray-400 leading-relaxed font-medium">
                    Trabajando por la dignidad de los trabajadores y
                    trabajadoras de la Universidad Nacional de Luján.
                </p>
            </div>

            {
                footerSections.map((section) => (
                    <div>
                        <h4 class="font-black text-sm uppercase tracking-[0.2em] mb-8 text-atunlu-blue">
                            {section.title}
                        </h4>
                        <ul class="space-y-4 text-gray-400 font-medium">
                            {section.links.map((link) => (
                                <li>
                                    <a
                                        href={link.href}
                                        class="hover:text-white transition-colors"
                                    >
                                        {link.label}
                                    </a>
                                </li>
                            ))}
                        </ul>
                    </div>
                ))
            }

            <div>
                <h4
                    class="font-black text-sm uppercase tracking-[0.2em] mb-8 text-atunlu-blue"
                >
                    Ubicación
                </h4>
                <div class="bg-white/5 p-6 rounded-3xl border border-white/10">
                    <a
                        href="https://maps.app.goo.gl/v67dSfB4VhqssXYQ7"
                        target="_blank"
                        class="inline-block mb-4 text-xs font-black text-atunlu-blue uppercase tracking-widest hover:text-white transition-colors"
                        >Ver en Google Maps</a
                    >
                    <div class="rounded-2xl overflow-hidden h-32 w-full">
                        <iframe
                            width="100%"
                            height="100%"
                            style="border:0; filter: grayscale(1) invert(0.9) contrast(0.8);"
                            src="https://www.google.com/maps?q=-34.5760336,-59.0896557&z=16&output=embed"
                            allowfullscreen=""
                            loading="lazy"
                        >
                        </iframe>
                    </div>
                    <p class="text-sm leading-relaxed text-gray-300 mt-3">
                        Av. Constitución 2288, B6700 Luján, Provincia de Buenos
                        Aires.
                    </p>
                </div>
            </div>
        </div>

        <div
            class="pt-12 border-t border-white/10 flex flex-col md:flex-row justify-between items-center gap-6 text-[10px] font-black tracking-[0.3em] text-gray-600"
        >
            <p>
                © 2026 ATUNLu - Asociación de Trabajadoras y Trabajadores de la
                UNLu
            </p>
        </div>
    </div>
</footer>
